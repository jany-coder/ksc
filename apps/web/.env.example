# Copy to apps/web/.env (never commit the real file).
# Neon Postgres connection string — provided later by the club owner.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs session cookies. Generate one per environment: `openssl rand -base64 32`.
# Anyone who knows it can forge a login, so never share or commit it.
BETTER_AUTH_SECRET="replace-with-a-random-32-plus-character-string"
# The public base URL of the app. Local dev runs on port 3001.
BETTER_AUTH_URL="http://localhost:3001"

# Optional: Cloudflare Turnstile on the /join form (free). Set BOTH or neither:
# the secret key as a Worker secret (wrangler secret put TURNSTILE_SECRET_KEY),
# the site key at build time. Without them the form has no check.
# TURNSTILE_SECRET_KEY="..."
# VITE_TURNSTILE_SITE_KEY="..."
